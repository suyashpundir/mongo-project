# MongoDB Connection (MongoDB Atlas or Local MongoDB)
# For local Docker: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=netpulse

# AI & Semantic Embeddings (Gemini API)
# Leave empty to use built-in local deterministic vectorizer fallback
GEMINI_API_KEY=

# Embedding Model Configuration
EMBEDDING_MODEL=text-embedding-004
SYNTHESIS_MODEL=gemini-2.5-flash

# Frontend Vercel & Production Environment
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# Vercel Deployment Secrets (Required for GitHub Actions Deployments)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
